{
  "apiVersion": "v1",
  "kind": "manifest.extension.airi.moeru.ai",
  "id": "airi-twitch-chat",
  "permissions": {
    "apis": [
      {
        "key": "kit.tool",
        "actions": ["invoke"],
        "reason": "Register Twitch chat tools (read messages, send messages, connection status) for the character"
      },
      {
        "key": "kit.gamelet",
        "actions": ["invoke"],
        "reason": "Mount and open the in-app Twitch configuration widget"
      },
      {
        "key": "proj-airi:plugin-sdk:apis:client:bindings:announce",
        "actions": ["invoke"],
        "reason": "Announce the configuration widget binding"
      }
    ],
    "resources": [
      {
        "key": "proj-airi:plugin-sdk:resources:kits:kit.gamelet:bindings",
        "actions": ["write"],
        "reason": "Create the configuration widget binding"
      }
    ]
  },
  "entrypoints": {
    "electron": "./index.mjs"
  }
}
